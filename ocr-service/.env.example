# ============================================================
#  OCR SERVICE ENVIRONMENT VARIABLES
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to version control.
# ============================================================

# ---- Application ----
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info

# ---- Upload limits ----
MAX_IMAGE_SIZE_MB=15

# ---- OCR Configuration ----
# Set to true only if the machine has a CUDA-capable GPU and paddlepaddle-gpu is installed.
OCR_USE_GPU=false
