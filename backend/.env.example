# ============================================================
#  BACKEND ENVIRONMENT VARIABLES
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to version control.
# ============================================================

# ---- Application ----
NODE_ENV=development
PORT=5000

# ---- PostgreSQL (via Prisma) --------------------------------
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/legal_metrology_db?schema=public"

# ---- OCR Service --------------------------------------------
# URL of the running Python FastAPI OCR service
OCR_SERVICE_URL="http://localhost:8000/api/v1/ocr/process-image"
# Timeout in milliseconds for each OCR request
OCR_TIMEOUT_MS=15000

# ---- File Storage -------------------------------------------
# Absolute or relative path where uploaded images are saved.
# Must be writable by the Node process.
# WARNING: Do NOT point this at a path inside node_modules or src/.
STORAGE_DIR="./storage/uploads"
# Maximum allowed upload size per file, in megabytes.
MAX_UPLOAD_SIZE_MB=15
# Allowed MIME types (comma-separated, no spaces)
ALLOWED_MIME_TYPES="image/jpeg,image/png,image/webp,image/tiff"
